    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\nThe contribution of providing intellectual leadership and direction for the research.  \n"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
