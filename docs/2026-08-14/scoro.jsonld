      }
    ],
    "http://purl.org/vocab/vann/changes": [
      {
        "@language": "en",
        "@value": "\n* **v1.10.1**: added new documentation, including annotation properties (e.g., `bibo:doi`, `schema:codeRepository`, etc.), term properties (e.g., `vann:example`, `vs:term_status`, etc.), exemplary competency questions with their respective SPARQL queries, and a Grafoo diagram.\n    "
      }
    ],
    "http://purl.org/vocab/vann/preferredNamespacePrefix": [
      {
