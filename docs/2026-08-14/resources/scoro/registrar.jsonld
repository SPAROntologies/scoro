    "http://purl.org/vocab/vann/example": [
      {
        "@value": "\n    :my-person a foaf:Person ;\n        pro:holdsRoleInTime :my-person-role .\n\n    :my-person-role a pro:RoleInTime ;\n        pro:withRole scoro:registrar .\n    "
      }
